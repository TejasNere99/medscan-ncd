# ===================================================================
# MedScan-NCD ML Microservice (FastAPI) Environment Configuration
# ===================================================================
# On cloud hosts (Render, Railway, Docker), configure these as environment variables.
# ===================================================================

PORT=8000

# Shared internal cryptographic key. Must match ML_INTERNAL_API_KEY in the Express backend.
# Generate with: openssl rand -base64 32
ML_INTERNAL_API_KEY=your_shared_internal_secret_key_between_backend_and_ml

# Optional Python logging level (INFO, WARNING, DEBUG)
LOG_LEVEL=INFO
