# ===================================================================
# MedScan-NCD Backend Environment Configuration Template
# ===================================================================
# Copy this file to .env and configure all variables for your environment.
# In hosted environments (Render, Railway, etc.), configure these via the
# service dashboard environment variables interface.
# ===================================================================

NODE_ENV=production
PORT=5000

# -------------------------------------------------------------------
# Database Configuration (MongoDB Atlas or Managed MongoDB)
# -------------------------------------------------------------------
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/medscan_production?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/medscan_production?retryWrites=true&w=majority

# -------------------------------------------------------------------
# Cryptographic Security & JWT Session Configuration
# -------------------------------------------------------------------
# Generate 64-character hex strings: openssl rand -hex 32
JWT_ACCESS_SECRET=your_production_access_secret_min_32_characters_here
JWT_REFRESH_SECRET=your_production_refresh_secret_min_32_characters_here
JWT_ACCESS_EXPIRE=1d
JWT_REFRESH_EXPIRE=7d

# -------------------------------------------------------------------
# Frontend Origins & Cross-Origin Resource Sharing (CORS)
# -------------------------------------------------------------------
# Primary URL where the React/Vite frontend is deployed (no trailing slash)
CLIENT_URL=https://your-frontend.vercel.app
FRONTEND_URL=https://your-frontend.vercel.app

# Optional comma-separated list of additional allowed origins (e.g., custom domain + preview domains)
ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://medscan.yourdomain.com

# -------------------------------------------------------------------
# Persistent Medical Report Document Storage (Cloudinary)
# -------------------------------------------------------------------
# Required for hosted deployments so uploaded reports survive container restarts.
# Free accounts available at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Set to false in production with Cloudinary configured, or true for local dev
LOCAL_STORAGE_FALLBACK=false

# -------------------------------------------------------------------
# Machine Learning Microservice Integration (FastAPI)
# -------------------------------------------------------------------
# URL of your deployed Python FastAPI service (no trailing slash)
ML_SERVICE_URL=https://your-ml-service.onrender.com/predict
DIABETES_ML_SERVICE_URL=https://your-ml-service.onrender.com

# Shared internal cryptographic key protecting backend-to-ML inference calls.
# Must match ML_INTERNAL_API_KEY in the ML service environment.
# Generate with: openssl rand -base64 32
ML_INTERNAL_API_KEY=your_shared_internal_secret_key_between_backend_and_ml

# -------------------------------------------------------------------
# Email Service Configuration (Nodemailer)
# -------------------------------------------------------------------
# Used for Patient verification links and secure password reset emails.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-account@gmail.com
EMAIL_PASS=your-16-character-google-app-password
EMAIL_FROM=noreply@medscan.yourdomain.com
EMAIL_FROM_NAME=MedScan-NCD Platform
EMAIL_VERIFICATION_EXPIRY_MINUTES=30
PASSWORD_RESET_EXPIRY_MINUTES=15

# -------------------------------------------------------------------
# Rate Limiting Controls
# -------------------------------------------------------------------
RATE_LIMIT_MAX=1500
AUTH_RATE_LIMIT_MAX=30

# -------------------------------------------------------------------
# Faculty Demonstration Seeding (Optional)
# -------------------------------------------------------------------
# Standard demonstration password for clinical accounts (Patient, Doctor, CHO)
DEMO_USER_PASSWORD=MedScanDemo!2026

# Private custom password for the Admin demo account.
# If omitted, defaults to DEMO_USER_PASSWORD and writes to .demo_credentials.local.json
ADMIN_DEMO_PASSWORD=

# Guard required to allow seeding into a non-loopback MongoDB Atlas cluster:
DEMO_SEED_CONFIRM=false
