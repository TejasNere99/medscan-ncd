# ===================================================================
# MedScan-NCD Frontend Environment Configuration Template
# ===================================================================
# In hosted environments (Vercel, Netlify, Render Static Site), configure
# these environment variables in the project build settings.
# ===================================================================

# Base URL of your deployed Express backend API (include /api, no trailing slash)
# Example: https://medscan-backend.onrender.com/api
VITE_API_URL=https://your-backend.onrender.com/api

# Faculty Demonstration Mode:
# - Set to 'true' to display the one-click "Demo Accounts" role cards on /login
# - Set to 'false' (or omit) for clinical production deployment (standard login only)
VITE_ENABLE_DEMO_ACCOUNTS=true
